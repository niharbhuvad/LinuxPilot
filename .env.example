# LinuxAI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./linuxai.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/linuxai

# ── Command Execution ─────────────────────────────────────────────────────────
MAX_COMMAND_TIMEOUT=30       # seconds
MAX_OUTPUT_SIZE=65536        # bytes — truncate large command output
ENABLE_AUTONOMOUS_MODE=false # Never enable without review

# ── Monitoring Thresholds ─────────────────────────────────────────────────────
DISK_WARNING_THRESHOLD=85    # percent
DISK_CRITICAL_THRESHOLD=90
CPU_WARNING_THRESHOLD=80
MEMORY_WARNING_THRESHOLD=85

# ── Frontend ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
